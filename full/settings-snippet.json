{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/opus-rails.py compact" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/opus-rails.py prompt" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/opus-rails.py plan" }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/opus-rails.py plan" }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/opus-rails.py dispatch" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(WebFetch|WebSearch)$",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/opus-rails.py web" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/opus-rails.py precompact" }
        ]
      }
    ]
  }
}
